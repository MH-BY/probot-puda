NATS_SERVERS=nats://bears:4222,nats://bears:4223,nats://bears:4224
MACHINE_ID=probot-keysight-pico

# Keysight SMU: set an explicit VISA address (recommended). If blank, the driver
# falls back to the KEYSIGHT_DEVICE_NO-th VISA resource found.
KEYSIGHT_ADDRESS=
KEYSIGHT_DEVICE_NO=0

# Pico G2V light controller (Ethernet) - co-located with the SMU because several
# measurements drive the light inline during the SMU acquisition.
# Set to your controller's link-local IP and device serial id.
PICO_IP=169.254.0.0
PICO_ID=YOUR_PICO_DEVICE_ID

# Writable directory for saved output data (measurement settings come in as
# command arguments, so there is no parameter directory to configure).
DATA_DIR=./Data/Keysight
